model User {
  id        String                @id @default(uuid())
  name      String
  email     String                @unique
  password  String
  role      Role                  @default(CUSTOMER)
  status    Status                @default(ACTIVE)
  profilePhoto String?
  profile   Technician?
  ctRequest CustomerToTechnician?
  bookings  Booking[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
