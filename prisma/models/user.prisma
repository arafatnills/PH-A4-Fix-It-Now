model User {
  id       String             @id @default(uuid())
  name     String
  email    String             @unique
  password String
  role     Role               @default(CUSTOMER)
  status   Status             @default(ACTIVE)
  profile  TechnicianProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
