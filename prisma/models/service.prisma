model Service {
  id           String            @id @default(uuid())
  serviceName  String            @db.VarChar(75)
  description  String  
  thumbnail    String  
  isPopular    Boolean?           @default(false)        
  
  categoriesId String
  category     Category          @relation(fields: [categoriesId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  
  price        Int
  city         String
  area         String

  bookings     Booking[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId, price])
  @@map("services")
}
