model Service {
  id           String            @id @default(uuid())
  serviceName  String            @db.VarChar(75)
  categoriesId String 
  category     Category          @relation(fields: [categoriesId], references: [id], onDelete: Cascade)
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  price        Decimal
  city     String
  area     String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}
